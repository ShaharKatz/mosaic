{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "summary", "findings", "proposed_mutations", "addressed_pr_comments"],
  "properties": {
    "verdict": { "type": "string", "enum": ["ship", "revise", "block"] },
    "summary": { "type": "string" },
    "findings": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "severity", "category", "file", "lines", "trigger", "fix", "confidence"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "nit"] },
          "category": { "type": "string" }, "file": { "type": "string" }, "lines": { "type": "string" },
          "trigger": { "type": "string" }, "fix": { "type": "string" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "proposed_mutations": {
      "type": "array", "description": "Requested counterexamples, never automatic approval to execute. Targets must be tracked, contained, non-linked files; old must match once. A surviving mutation describes only the selected tests.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "file", "old", "new", "test_paths", "expectation"],
        "properties": {
          "label": { "type": "string" }, "file": { "type": "string" }, "old": { "type": "string" }, "new": { "type": "string" },
          "test_paths": { "type": "array", "items": { "type": "string" } },
          "expectation": { "type": "string", "enum": ["should_be_caught", "should_survive"] }
        }
      }
    },
    "addressed_pr_comments": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["comment", "status", "evidence"],
        "properties": {
          "comment": { "type": "string" }, "status": { "type": "string", "enum": ["addressed", "not_addressed", "partially", "n/a"] },
          "evidence": { "type": "string" }
        }
      }
    }
  }
}
